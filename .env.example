# Leave both empty to run in demo mode (data kept in the browser, demo users, no password).
# Fill both to use Supabase (Project Settings → API). The anon / publishable key is safe for the browser.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (as Supabase's Connect dialog shows them) also work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
